---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found — Taeyun Kim"><section class="missing shell"><p class="eyebrow">404 · Route unavailable</p><h1>경로를 찾을 수 없습니다.</h1><a class="button button--primary" href={base}>홈으로 돌아가기</a></section></BaseLayout>
<style>.missing{min-height:70vh;display:grid;place-content:center;justify-items:start;background:linear-gradient(135deg,#fbfbf8,#eaf3ec)}.missing h1{font-size:clamp(2.5rem,7vw,6rem);max-width:800px}</style>
