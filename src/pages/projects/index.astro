---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projectCategoryOrder, projects } from '../../data/projects';

const categoryDescriptions = {
  'Learning-based Autonomous Driving': 'Imitation Learning, Offline RL, Sim-to-Real과 V2I End-to-End driving',
  'Autonomous Driving Systems': '판단 아키텍처, 주차 계획·제어와 실차 시스템 통합',
  'Localization & Mapping': '2D LiDAR mapping, localization과 환경 변화에 따른 지도 재사용 문제',
  'Foundation / Other Experience': '차량 제어의 출발점과 이기종 시스템 통합 경험',
};
---

<BaseLayout title="Projects — Taeyun Kim" description="자율주행 학습, 경로 계획과 제어, Sim-to-Real, 실차 시스템 통합 프로젝트">
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">Project Archive · {projects.length} projects</p>
      <h1>Projects</h1>
      <p>프로젝트를 연구와 기술 분야별로 정리했습니다. 각 상세 페이지에서 문제, 개인 기여, 구현과 검증 범위를 구분해 확인할 수 있습니다.</p>
    </div>
  </header>

  <div class="project-archive">
    {projectCategoryOrder.map((category, categoryIndex) => {
      const entries = projects.filter((project) => project.category === category);
      return (
        <section class:list={['category-section', category === 'Foundation / Other Experience' && 'category-section--secondary']}>
          <div class="shell">
            <header class="category-heading reveal">
              <span class="mono">{String(categoryIndex + 1).padStart(2, '0')}</span>
              <div><h2>{category}</h2><p>{categoryDescriptions[category]}</p></div>
              <strong class="mono">{entries.length} PROJECTS</strong>
            </header>
            <div class="project-grid">
              {entries.map((project, index) => <ProjectCard project={project} index={index} />)}
            </div>
          </div>
        </section>
      );
    })}
  </div>
</BaseLayout>

<style>
  .page-hero { padding: clamp(5.5rem,10vw,8rem) 0 4.5rem; border-bottom: 1px solid var(--line); background: linear-gradient(135deg,#f7faf6,#e8f2eb); }
  .page-hero h1 { margin: .7rem 0 1.25rem; }
  .page-hero p:last-child { max-width: 760px; margin-bottom: 0; color: var(--muted); font-size: 1.1rem; line-height: 1.8; }
  .project-archive { background: #fff; }
  .category-section { padding: clamp(4.5rem,8vw,7rem) 0; border-bottom: 1px solid var(--line); }
  .category-section:nth-child(even) { background: var(--paper); }
  .category-section--secondary { background: #f1f3ef !important; }
  .category-heading { display: grid; grid-template-columns: 4rem minmax(0,1fr) auto; gap: 1.5rem; align-items: start; margin-bottom: 2.5rem; padding-bottom: 1.4rem; border-bottom: 4px solid var(--green-deep); }
  .category-heading > span,.category-heading > strong { color: var(--green-deep); }
  .category-heading h2 { margin: 0 0 .5rem; font-size: clamp(1.9rem,4vw,3.1rem); }
  .category-heading p { margin: 0; color: var(--muted); }
  .project-grid { display: grid; grid-template-columns: 1fr; }
  @media (max-width: 680px) {
    .category-heading { grid-template-columns: 2.5rem 1fr; gap: .8rem; }
    .category-heading > strong { grid-column: 2; }
  }
</style>
